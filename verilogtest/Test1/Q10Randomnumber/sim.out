#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x56e1c8062b90 .scope module, "tb_random_generator" "tb_random_generator" 2 2;
 .timescale 0 0;
S_0x56e1c8062d20 .scope module, "dut" "random_generator" 2 4, 3 2 0, S_0x56e1c8062b90;
 .timescale 0 0;
v0x56e1c8029490_0 .var/i "random_num", 31 0;
v0x56e1c80737a0_0 .var/i "temp", 31 0;
    .scope S_0x56e1c8062d20;
T_0 ;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x56e1c8029490_0, 0, 32;
T_0.0 ;
    %delay 10, 0;
    %vpi_func 3 13 "$random" 32 {0 0 0};
    %pushi/vec4 2147483647, 0, 32;
    %and;
    %store/vec4 v0x56e1c80737a0_0, 0, 32;
    %load/vec4 v0x56e1c80737a0_0;
    %pushi/vec4 201, 0, 32;
    %mod/s;
    %subi 100, 0, 32;
    %store/vec4 v0x56e1c8029490_0, 0, 32;
    %jmp T_0.0;
    %end;
    .thread T_0;
    .scope S_0x56e1c8062b90;
T_1 ;
    %vpi_call 2 7 "$dumpfile", "random.vcd" {0 0 0};
    %vpi_call 2 8 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x56e1c8062b90 {0 0 0};
    %end;
    .thread T_1;
    .scope S_0x56e1c8062b90;
T_2 ;
    %vpi_call 2 12 "$monitor", "Time=%0t | Random number=%0d", $time, v0x56e1c8029490_0 {0 0 0};
    %end;
    .thread T_2;
    .scope S_0x56e1c8062b90;
T_3 ;
    %delay 200, 0;
    %vpi_call 2 18 "$finish" {0 0 0};
    %end;
    .thread T_3;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "tb_random_generator.v";
    "random_generator.v";
