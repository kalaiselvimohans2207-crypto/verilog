
`timescale 1ns/1ps

module tb_sequence_detector;

    reg clk;
    reg reset;
    reg din;
    wire dout;

    // DUT instantiation
    sequence_detector dut (
        .clk(clk),
        .reset(reset),
        .din(din),
        .dout(dout)
    );

    // Clock generation
    initial begin
        clk = 0;
        forever #5 clk = ~clk;
    end

    // Input stimulus
    initial begin

        $dumpfile("sequence.vcd");
        $dumpvars(0, tb_sequence_detector);

        reset = 1;
        din = 0;

        #10;
        reset = 0;

        // Input sequence: 10110110
        #10 din = 1;
        #10 din = 0;
        #10 din = 1;
        #10 din = 1;
        #10 din = 0;
        #10 din = 1;
        #10 din = 1;
        #10 din = 0;

        #20;
        $finish;
    end

    // Monitor output
    initial begin
        $monitor("Time=%0t | clk=%b | reset=%b | din=%b | dout=%b | state=%b",
                  $time, clk, reset, din, dout, dut.state);
    end

endmodule
