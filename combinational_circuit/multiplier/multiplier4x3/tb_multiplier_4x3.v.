
module tb_multiplier_4x3;

    reg  [3:0] A;
    reg  [2:0] B;
    wire [6:0] P;

    integer i, j;

    multiplier_4x3 uut (
        .A(A),
        .B(B),
        .P(P)
    );

    initial begin
        $dumpfile("multiplier_4x3.vcd");
        $dumpvars(0, tb_multiplier_4x3);

        $display(" A     B     P");
        $display("-------------------");

        for (i = 0; i < 16; i = i + 1) begin
            for (j = 0; j < 8; j = j + 1) begin
                A = i;
                B = j;
                #10;
                $display("%04b  %03b  %07b", A, B, P);
            end
        end

        $finish;
    end

endmodule