v0x5aedb7dd93f0_0 .var "p", 0 0;
S_0x5aedb7dc5b80 .scope module, "uut" "parity_checker" 2 6, 3 1 0, S_0x5aedb7dc59f0;
 .timescale 0 0;
    .port_info 0 /INPUT 4 "a";
    .port_info 1 /INPUT 1 "p";
    .port_info 2 /OUTPUT 1 "error";
v0x5aedb7dc5db0_0 .net "a", 3 0, v0x5aedb7dd9160_0;  1 drivers
v0x5aedb7dd8f80_0 .var "error", 0 0;
v0x5aedb7dd9040_0 .net "p", 0 0, v0x5aedb7dd93f0_0;  1 drivers
E_0x5aedb7d8cfe0 .event anyedge, v0x5aedb7dc5db0_0, v0x5aedb7dd9040_0;
    .scope S_0x5aedb7dc5b80;
T_0 ;
    %wait E_0x5aedb7d8cfe0;
    %load/vec4 v0x5aedb7dc5db0_0;
    %xor/r;
    %load/vec4 v0x5aedb7dd9040_0;
    %cmp/e;
    %jmp/0xz  T_0.0, 4;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5aedb7dd8f80_0, 0, 1;
    %jmp T_0.1;
T_0.0 ;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5aedb7dd8f80_0, 0, 1;
T_0.1 ;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0x5aedb7dc59f0;
T_1 ;
    %vpi_call 2 13 "$dumpfile", "parity_checker.vcd" {0 0 0};
    %vpi_call 2 14 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5aedb7dc59f0 {0 0 0};
    %vpi_call 2 15 "$monitor", "time=0%t,a=%b,p=%b,error=%b", $time, v0x5aedb7dd9160_0, v0x5aedb7dd93f0_0, v0x5aedb7dd9250_0 {0 0 0};
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x5aedb7dd9320_0, 0, 32;
T_1.0 ;
    %load/vec4 v0x5aedb7dd9320_0;
    %cmpi/s 16, 0, 32;
    %jmp/0xz T_1.1, 5;
    %load/vec4 v0x5aedb7dd9320_0;
    %pad/s 4;
    %store/vec4 v0x5aedb7dd9160_0, 0, 4;
    %load/vec4 v0x5aedb7dd9160_0;
    %xor/r;
    %store/vec4 v0x5aedb7dd93f0_0, 0, 1;
    %delay 10, 0;
    %load/vec4 v0x5aedb7dd9160_0;
    %xor/r;
    %inv;
    %store/vec4 v0x5aedb7dd93f0_0, 0, 1;
    %delay 10, 0;
    %load/vec4 v0x5aedb7dd9320_0;
    %addi 1, 0, 32;
    %store/vec4 v0x5aedb7dd9320_0, 0, 32;
    %jmp T_1.0;
T_1.1 ;
    %vpi_call 2 23 "$finish" {0 0 0};
    %end;
    .thread T_1;
