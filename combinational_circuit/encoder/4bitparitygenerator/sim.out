#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x55e7f46cf200 .scope module, "tb_parity_generator" "tb_parity_generator" 2 1;
 .timescale 0 0;
v0x55e7f46e1020_0 .var "a", 3 0;
v0x55e7f46e10e0_0 .var/i "i", 31 0;
v0x55e7f46e11a0_0 .net "p", 0 0, L_0x55e7f46e12a0;  1 drivers
S_0x55e7f46cf390 .scope module, "uut" "parity_generator" 2 5, 3 1 0, S_0x55e7f46cf200;
 .timescale 0 0;
    .port_info 0 /INPUT 4 "a";
    .port_info 1 /OUTPUT 1 "p";
v0x55e7f46cf570_0 .net "a", 3 0, v0x55e7f46e1020_0;  1 drivers
v0x55e7f46e0f00_0 .net "p", 0 0, L_0x55e7f46e12a0;  alias, 1 drivers
L_0x55e7f46e12a0 .reduce/xor v0x55e7f46e1020_0;
    .scope S_0x55e7f46cf200;
T_0 ;
    %vpi_call 2 10 "$dumpfile", "parity_generator.vcd" {0 0 0};
    %vpi_call 2 11 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x55e7f46cf200 {0 0 0};
    %vpi_call 2 13 "$monitor", "time=%0t a=%b p=%b", $time, v0x55e7f46e1020_0, v0x55e7f46e11a0_0 {0 0 0};
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x55e7f46e10e0_0, 0, 32;
T_0.0 ;
    %load/vec4 v0x55e7f46e10e0_0;
    %cmpi/s 16, 0, 32;
    %jmp/0xz T_0.1, 5;
    %load/vec4 v0x55e7f46e10e0_0;
    %pad/s 4;
    %store/vec4 v0x55e7f46e1020_0, 0, 4;
    %delay 10, 0;
    %load/vec4 v0x55e7f46e10e0_0;
    %addi 1, 0, 32;
    %store/vec4 v0x55e7f46e10e0_0, 0, 32;
    %jmp T_0.0;
T_0.1 ;
    %vpi_call 2 18 "$finish" {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "tb_parity_generator.v";
    "parity_generator.v";
