#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5dc62c019e60 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5dc62c019ff0 .scope module, "tb_binary_to_decimal" "tb_binary_to_decimal" 3 4;
 .timescale -9 -12;
v0x5dc62c02f260_0 .var "binary", 7 0;
v0x5dc62c02f340_0 .net "hundreds", 3 0, v0x5dc62c02eee0_0;  1 drivers
v0x5dc62c02f410_0 .net "ones", 3 0, v0x5dc62c02efd0_0;  1 drivers
v0x5dc62c02f510_0 .net "tens", 3 0, v0x5dc62c02f0b0_0;  1 drivers
S_0x5dc62bfdf490 .scope module, "uut" "binary_to_decimal" 3 11, 4 2 0, S_0x5dc62c019ff0;
 .timescale 0 0;
    .port_info 0 /INPUT 8 "binary";
    .port_info 1 /OUTPUT 4 "hundreds";
    .port_info 2 /OUTPUT 4 "tens";
    .port_info 3 /OUTPUT 4 "ones";
v0x5dc62bfdf700_0 .net "binary", 7 0, v0x5dc62c02f260_0;  1 drivers
v0x5dc62c02ee00_0 .var/i "decimal_value", 31 0;
v0x5dc62c02eee0_0 .var "hundreds", 3 0;
v0x5dc62c02efd0_0 .var "ones", 3 0;
v0x5dc62c02f0b0_0 .var "tens", 3 0;
E_0x5dc62c0190f0 .event anyedge, v0x5dc62bfdf700_0, v0x5dc62c02ee00_0;
    .scope S_0x5dc62bfdf490;
T_0 ;
    %wait E_0x5dc62c0190f0;
    %load/vec4 v0x5dc62bfdf700_0;
    %pad/u 32;
    %store/vec4 v0x5dc62c02ee00_0, 0, 32;
    %load/vec4 v0x5dc62c02ee00_0;
    %pushi/vec4 100, 0, 32;
    %div/s;
    %pad/s 4;
    %store/vec4 v0x5dc62c02eee0_0, 0, 4;
    %load/vec4 v0x5dc62c02ee00_0;
    %pushi/vec4 100, 0, 32;
    %mod/s;
    %pushi/vec4 10, 0, 32;
    %div/s;
    %pad/s 4;
    %store/vec4 v0x5dc62c02f0b0_0, 0, 4;
    %load/vec4 v0x5dc62c02ee00_0;
    %pushi/vec4 10, 0, 32;
    %mod/s;
    %pad/s 4;
    %store/vec4 v0x5dc62c02efd0_0, 0, 4;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0x5dc62c019ff0;
T_1 ;
    %vpi_call/w 3 19 "$dumpfile", "binary_to_decimal.vcd" {0 0 0};
    %vpi_call/w 3 20 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5dc62c019ff0 {0 0 0};
    %vpi_call/w 3 22 "$monitor", "Time=%0t Binary=%b Decimal=%0d%0d%0d", $time, v0x5dc62c02f260_0, v0x5dc62c02f340_0, v0x5dc62c02f510_0, v0x5dc62c02f410_0 {0 0 0};
    %pushi/vec4 0, 0, 8;
    %store/vec4 v0x5dc62c02f260_0, 0, 8;
    %delay 10000, 0;
    %pushi/vec4 9, 0, 8;
    %store/vec4 v0x5dc62c02f260_0, 0, 8;
    %delay 10000, 0;
    %pushi/vec4 15, 0, 8;
    %store/vec4 v0x5dc62c02f260_0, 0, 8;
    %delay 10000, 0;
    %pushi/vec4 25, 0, 8;
    %store/vec4 v0x5dc62c02f260_0, 0, 8;
    %delay 10000, 0;
    %pushi/vec4 99, 0, 8;
    %store/vec4 v0x5dc62c02f260_0, 0, 8;
    %delay 10000, 0;
    %pushi/vec4 123, 0, 8;
    %store/vec4 v0x5dc62c02f260_0, 0, 8;
    %delay 10000, 0;
    %pushi/vec4 255, 0, 8;
    %store/vec4 v0x5dc62c02f260_0, 0, 8;
    %delay 10000, 0;
    %vpi_call/w 3 33 "$finish" {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
