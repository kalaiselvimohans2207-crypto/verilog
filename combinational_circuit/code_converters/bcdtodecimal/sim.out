#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x5da780fbfc50 .scope module, "tb_bcd_to_decimal" "tb_bcd_to_decimal" 2 4;
 .timescale -9 -12;
v0x5da780fd2ec0_0 .net "decimal_out", 6 0, v0x5da780f86490_0;  1 drivers
v0x5da780fd2fb0_0 .var "ones", 3 0;
v0x5da780fd3080_0 .var "tens", 3 0;
S_0x5da780fbfde0 .scope module, "uut" "bcd_to_decimal" 2 10, 3 2 0, S_0x5da780fbfc50;
 .timescale 0 0;
    .port_info 0 /INPUT 4 "tens";
    .port_info 1 /INPUT 4 "ones";
    .port_info 2 /OUTPUT 7 "decimal_out";
v0x5da780f86490_0 .var "decimal_out", 6 0;
v0x5da780fd2ca0_0 .net "ones", 3 0, v0x5da780fd2fb0_0;  1 drivers
v0x5da780fd2d80_0 .net "tens", 3 0, v0x5da780fd3080_0;  1 drivers
E_0x5da780f86a30 .event anyedge, v0x5da780fd2d80_0, v0x5da780fd2ca0_0;
    .scope S_0x5da780fbfde0;
T_0 ;
    %wait E_0x5da780f86a30;
    %load/vec4 v0x5da780fd2d80_0;
    %pad/u 7;
    %muli 10, 0, 7;
    %load/vec4 v0x5da780fd2ca0_0;
    %pad/u 7;
    %add;
    %store/vec4 v0x5da780f86490_0, 0, 7;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0x5da780fbfc50;
T_1 ;
    %vpi_call 2 17 "$dumpfile", "bcd_to_decimal.vcd" {0 0 0};
    %vpi_call 2 18 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5da780fbfc50 {0 0 0};
    %vpi_call 2 20 "$monitor", "BCD=%b%b Decimal=%0d", v0x5da780fd3080_0, v0x5da780fd2fb0_0, v0x5da780fd2ec0_0 {0 0 0};
    %pushi/vec4 0, 0, 4;
    %store/vec4 v0x5da780fd3080_0, 0, 4;
    %pushi/vec4 5, 0, 4;
    %store/vec4 v0x5da780fd2fb0_0, 0, 4;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 4;
    %store/vec4 v0x5da780fd3080_0, 0, 4;
    %pushi/vec4 2, 0, 4;
    %store/vec4 v0x5da780fd2fb0_0, 0, 4;
    %delay 10000, 0;
    %pushi/vec4 2, 0, 4;
    %store/vec4 v0x5da780fd3080_0, 0, 4;
    %pushi/vec4 5, 0, 4;
    %store/vec4 v0x5da780fd2fb0_0, 0, 4;
    %delay 10000, 0;
    %pushi/vec4 4, 0, 4;
    %store/vec4 v0x5da780fd3080_0, 0, 4;
    %pushi/vec4 9, 0, 4;
    %store/vec4 v0x5da780fd2fb0_0, 0, 4;
    %delay 10000, 0;
    %pushi/vec4 9, 0, 4;
    %store/vec4 v0x5da780fd3080_0, 0, 4;
    %pushi/vec4 9, 0, 4;
    %store/vec4 v0x5da780fd2fb0_0, 0, 4;
    %delay 10000, 0;
    %vpi_call 2 29 "$finish" {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "tb_bcd_to_decimal.v";
    "bcd_to_decimal.v";
