:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x5a3be1de3d40 .scope module, "tb_decimal_to_bcd" "tb_decimal_to_bcd" 2 2;
 .timescale 0 0;
v0x5a3be1df6a40_0 .var "decimal_in", 6 0;
v0x5a3be1df6b30_0 .net "ones", 3 0, v0x5a3be1df6820_0;  1 drivers
v0x5a3be1df6c00_0 .net "tens", 3 0, v0x5a3be1df6900_0;  1 drivers
S_0x5a3be1de3ed0 .scope module, "uut" "decimal_to_bcd" 2 8, 3 2 0, S_0x5a3be1de3d40;
 .timescale 0 0;
    .port_info 0 /INPUT 7 "decimal_in";
    .port_info 1 /OUTPUT 4 "tens";
    .port_info 2 /OUTPUT 4 "ones";
v0x5a3be1de40b0_0 .net "decimal_in", 6 0, v0x5a3be1df6a40_0;  1 drivers
v0x5a3be1df6820_0 .var "ones", 3 0;
v0x5a3be1df6900_0 .var "tens", 3 0;
E_0x5a3be1daaee0 .event anyedge, v0x5a3be1de40b0_0;
    .scope S_0x5a3be1de3ed0;
T_0 ;
    %wait E_0x5a3be1daaee0;
    %load/vec4 v0x5a3be1de40b0_0;
    %pad/u 32;
    %pushi/vec4 10, 0, 32;
    %div;
    %pad/u 4;
    %store/vec4 v0x5a3be1df6900_0, 0, 4;
    %load/vec4 v0x5a3be1de40b0_0;
    %pad/u 32;
    %pushi/vec4 10, 0, 32;
    %mod;
    %pad/u 4;
    %store/vec4 v0x5a3be1df6820_0, 0, 4;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0x5a3be1de3d40;
T_1 ;
    %vpi_call 2 15 "$dumpfile", "decimal_to_bcd.vcd" {0 0 0};
    %vpi_call 2 16 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5a3be1de3d40 {0 0 0};
    %vpi_call 2 18 "$monitor", "Input=%0d Tens=%b Ones=%b BCD=%b%b", v0x5a3be1df6a40_0, v0x5a3be1df6c00_0, v0x5a3be1df6b30_0, v0x5a3be1df6c00_0, v0x5a3be1df6b30_0 {0 0 0};
    %pushi/vec4 0, 0, 7;
    %store/vec4 v0x5a3be1df6a40_0, 0, 7;
    %delay 10, 0;
    %pushi/vec4 9, 0, 7;
    %store/vec4 v0x5a3be1df6a40_0, 0, 7;
    %delay 10, 0;
    %pushi/vec4 12, 0, 7;
    %store/vec4 v0x5a3be1df6a40_0, 0, 7;
    %delay 10, 0;
    %pushi/vec4 25, 0, 7;
    %store/vec4 v0x5a3be1df6a40_0, 0, 7;
    %delay 10, 0;
    %pushi/vec4 49, 0, 7;
    %store/vec4 v0x5a3be1df6a40_0, 0, 7;
    %delay 10, 0;
    %pushi/vec4 99, 0, 7;
    %store/vec4 v0x5a3be1df6a40_0, 0, 7;
    %delay 10, 0;
    %vpi_call 2 28 "$finish" {0 0 0};
    %end;
    .thread T_1;
