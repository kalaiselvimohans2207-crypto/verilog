#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5da4ab010ee0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5da4ab011070 .scope module, "tb_simple_ram" "tb_simple_ram" 3 4;
 .timescale -9 -12;
v0x5da4ab028380_0 .var "addr", 3 0;
v0x5da4ab028460_0 .var "clk", 0 0;
v0x5da4ab028530_0 .net "rdata", 7 0, v0x5da4ab028010_0;  1 drivers
v0x5da4ab028630_0 .var "wdata", 7 0;
v0x5da4ab028700_0 .var "we", 0 0;
S_0x5da4aafd6490 .scope module, "dut" "simple_ram" 3 14, 4 1 0, S_0x5da4ab011070;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "we";
    .port_info 2 /INPUT 4 "addr";
    .port_info 3 /INPUT 8 "wdata";
    .port_info 4 /OUTPUT 8 "rdata";
v0x5da4aafd6690_0 .net "addr", 3 0, v0x5da4ab028380_0;  1 drivers
v0x5da4ab027e80_0 .net "clk", 0 0, v0x5da4ab028460_0;  1 drivers
v0x5da4ab027f40 .array "mem", 15 0, 7 0;
v0x5da4ab028010_0 .var "rdata", 7 0;
v0x5da4ab0280f0_0 .net "wdata", 7 0, v0x5da4ab028630_0;  1 drivers
v0x5da4ab028220_0 .net "we", 0 0, v0x5da4ab028700_0;  1 drivers
E_0x5da4ab010430 .event posedge, v0x5da4ab027e80_0;
    .scope S_0x5da4aafd6490;
T_0 ;
    %wait E_0x5da4ab010430;
    %load/vec4 v0x5da4ab028220_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %load/vec4 v0x5da4ab0280f0_0;
    %load/vec4 v0x5da4aafd6690_0;
    %pad/u 6;
    %ix/vec4 3;
    %ix/load 4, 0, 0; Constant delay
    %assign/vec4/a/d v0x5da4ab027f40, 0, 4;
T_0.0 ;
    %load/vec4 v0x5da4aafd6690_0;
    %pad/u 6;
    %ix/vec4 4;
    %load/vec4a v0x5da4ab027f40, 4;
    %assign/vec4 v0x5da4ab028010_0, 0;
    %jmp T_0;
    .thread T_0;
    .scope S_0x5da4ab011070;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5da4ab028460_0, 0, 1;
T_1.0 ;
    %delay 5000, 0;
    %load/vec4 v0x5da4ab028460_0;
    %inv;
    %store/vec4 v0x5da4ab028460_0, 0, 1;
    %jmp T_1.0;
    %end;
    .thread T_1;
    .scope S_0x5da4ab011070;
T_2 ;
    %vpi_call/w 3 31 "$dumpfile", "dump.vcd" {0 0 0};
    %vpi_call/w 3 32 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5da4ab011070 {0 0 0};
    %vpi_call/w 3 34 "$monitor", "Time=%0t | clk=%b | we=%b | addr=%d | wdata=%h | rdata=%h", $time, v0x5da4ab028460_0, v0x5da4ab028700_0, v0x5da4ab028380_0, v0x5da4ab028630_0, v0x5da4ab028530_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5da4ab028700_0, 0, 1;
    %pushi/vec4 0, 0, 4;
    %store/vec4 v0x5da4ab028380_0, 0, 4;
    %pushi/vec4 0, 0, 8;
    %store/vec4 v0x5da4ab028630_0, 0, 8;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5da4ab028700_0, 0, 1;
    %pushi/vec4 0, 0, 4;
    %store/vec4 v0x5da4ab028380_0, 0, 4;
    %pushi/vec4 37, 0, 8;
    %store/vec4 v0x5da4ab028630_0, 0, 8;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 4;
    %store/vec4 v0x5da4ab028380_0, 0, 4;
    %pushi/vec4 80, 0, 8;
    %store/vec4 v0x5da4ab028630_0, 0, 8;
    %delay 10000, 0;
    %pushi/vec4 2, 0, 4;
    %store/vec4 v0x5da4ab028380_0, 0, 4;
    %pushi/vec4 165, 0, 8;
    %store/vec4 v0x5da4ab028630_0, 0, 8;
    %delay 10000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5da4ab028700_0, 0, 1;
    %pushi/vec4 0, 0, 4;
    %store/vec4 v0x5da4ab028380_0, 0, 4;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 4;
    %store/vec4 v0x5da4ab028380_0, 0, 4;
    %delay 10000, 0;
    %pushi/vec4 2, 0, 4;
    %store/vec4 v0x5da4ab028380_0, 0, 4;
    %delay 10000, 0;
    %pushi/vec4 3, 0, 4;
    %store/vec4 v0x5da4ab028380_0, 0, 4;
    %delay 10000, 0;
    %vpi_call/w 3 78 "$finish" {0 0 0};
    %end;
    .thread T_2;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "tb_simple_ram.v";
    "simple_ram.v";
